# URL бэкенда для фронта.
# Пусто → mock-режим (данные в памяти).
# /api + прокси (см. BACKEND_PROXY_TARGET) → браузер видит один origin,
# CORS на бэкенде не нужен.
VITE_BACKEND_URL=/api

# Origin бэкенда, куда Vite-прокси форвардит /api (без пути /api).
# Локально: http://localhost:5040
# Туннель:  https://<subdomain>.tunnel4.com
BACKEND_PROXY_TARGET=http://localhost:5040
