{
  "name": "todo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.js eslint.config.js",
    "format": "prettier \"src/**/*.{js,css}\" index.html vite.config.js eslint.config.js package.json .prettierrc.json --write",
    "format:check": "prettier \"src/**/*.{js,css}\" index.html vite.config.js eslint.config.js package.json .prettierrc.json --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "^5.4.0",
    "vitest": "2.1.9"
  }
}
